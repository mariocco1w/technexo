# Copie este archivo a technexo-backend/config/application-local.yml
# o exporte las variables antes de arrancar. No ponga secretos reales aquí.

TECHNEXO_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=TechNexoDB;encrypt=false;trustServerCertificate=true;loginTimeout=30
TECHNEXO_DB_USERNAME=technexo_app
TECHNEXO_DB_PASSWORD=

# Opcional. Si se omiten, el primer arranque genera contraseñas nuevas
# y las escribe en credenciales-locales.txt (archivo local, no versionado).
TECHNEXO_ADMIN_EMAIL=admin@technexo.local
TECHNEXO_ADMIN_PASSWORD=
TECHNEXO_CLIENTE_EMAIL=cliente@technexo.local
TECHNEXO_CLIENTE_PASSWORD=
